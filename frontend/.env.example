# Copy to frontend/.env.local if needed. Only VITE_* variables reach the browser: never put secrets here.

# Backend origin for API calls. Empty = same origin (production image; the dev server proxies /api).
VITE_API_BASE_URL=
# Dev server only: where /api is proxied (default http://127.0.0.1:8000).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Dev server port (default 5173).
PORT=5173
