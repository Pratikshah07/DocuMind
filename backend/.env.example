# Copy to backend/.env and adjust. Never commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
# json (structured, default) or console (human-readable for local dev)
LOG_FORMAT=console

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Matches the postgres service in ../docker-compose.yml.
DATABASE_URL=postgresql+psycopg://documind:documind@127.0.0.1:5432/documind

# Where uploaded files are kept (relative paths are relative to backend/).
STORAGE_PATH=storage
# Maximum upload size in bytes (15 MB).
MAX_UPLOAD_SIZE=15728640

# --- Processing (Phase 3) ---
# Path to tesseract(.exe). Leave empty to use PATH, then the default Windows install
# location (C:\Program Files\Tesseract-OCR\tesseract.exe, from: winget install UB-Mannheim.TesseractOCR).
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=60
MAX_PAGES=50
# Pages whose PDF text layer has fewer non-space characters than this are OCR'd.
PDF_MIN_TEXT_CHARS=25
OCR_RENDER_DPI=300
# Preprocessing before OCR (comma-separated, in order). Steps: resize, grayscale, denoise, contrast, deskew, threshold
PREPROCESS_PDF_STEPS=grayscale,deskew
PREPROCESS_IMAGE_STEPS=resize,grayscale,denoise,contrast,deskew,threshold

# --- Extraction & validation (Phase 4) ---
# How to read ambiguous numeric dates such as 03/04/2025: DMY (3 April) or MDY (4 March).
# Ambiguous dates are flagged for review either way.
DATE_ORDER=DMY
# Confidence levels (High >= CONFIDENCE_HIGH, Medium >= CONFIDENCE_REVIEW, else Low).
# A required field below CONFIDENCE_REVIEW sends the document to NEEDS_REVIEW.
CONFIDENCE_HIGH=0.85
CONFIDENCE_REVIEW=0.60
# Allowed rounding difference for subtotal + tax - discount = total and line-item sums.
AMOUNT_TOLERANCE=0.02

# --- Storage backend & public demo (see docs/DEPLOYMENT.md) ---
# local = files under STORAGE_PATH; database = file bytes in PostgreSQL (hosts without a persistent disk)
STORAGE_BACKEND=local
# Require a per-browser X-Workspace-Token and keep visitors' documents separate (set true when public).
DEMO_MODE=false
# Delete documents after N hours (0 = keep).
RETENTION_HOURS=0
# Uploads + reprocessing per client IP per hour, and documents per workspace (0 = unlimited).
UPLOAD_RATE_LIMIT_PER_HOUR=0
MAX_DOCUMENTS_PER_WORKSPACE=0
# Documents processed at the same time.
MAX_CONCURRENT_JOBS=2
# Use X-Forwarded-For for client IPs (only behind a trusted reverse proxy).
TRUST_PROXY_HEADERS=false
# Serve the built frontend from this directory (the Docker image sets /app/static).
# STATIC_DIR=../frontend/dist
