# Copy to backend/.env and adjust. Never commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
# json (structured, default) or console (human-readable for local dev)
LOG_FORMAT=console

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Matches the postgres service in ../docker-compose.yml.
DATABASE_URL=postgresql+psycopg://documind:documind@127.0.0.1:5432/documind

# Where uploaded files are kept (relative paths are relative to backend/).
STORAGE_PATH=storage
# Maximum upload size in bytes (15 MB).
MAX_UPLOAD_SIZE=15728640
